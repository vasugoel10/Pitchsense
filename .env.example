# PitchSense Environment Variables
# Copy this file to .env and fill in your actual keys.
# NEVER commit your real .env file to version control.
#
# Get your keys here:
#   Groq (free tier):   https://console.groq.com/keys
#   Tavily (free tier): https://app.tavily.com/home

# Django secret key — generate one at: https://djecrety.ir/
DJANGO_SECRET_KEY=your-django-secret-key-here

# Set to False in production, True for local dev
DEBUG=True

# Comma-separated list of allowed hosts (your Railway/Render domain goes here)
# e.g. ALLOWED_HOSTS=pitchsense.up.railway.app,localhost
ALLOWED_HOSTS=localhost,127.0.0.1

# LLM Engine (Groq — ultra-fast Llama3/Mixtral inference)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Web Search for Competitor persona (Tavily)
TAVILY_API_KEY=tvly-your_tavily_api_key_here
