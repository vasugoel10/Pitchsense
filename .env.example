# PitchSense Environment Variables
# Copy this file to .env and fill in your actual keys.
# NEVER commit your real .env file to version control.
#
# Get your keys here:
#   Groq (free tier):   https://console.groq.com/keys
#   Tavily (free tier): https://app.tavily.com/home

# ── Required ─────────────────────────────────────────────────────────

# Django secret key — generate one at: https://djecrety.ir/
# REQUIRED in production. If not set in dev, a random key is auto-generated.
DJANGO_SECRET_KEY=your-django-secret-key-here

# LLM Engine (Groq — ultra-fast Llama3/Mixtral inference)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Web Search for Competitor persona (Tavily)
TAVILY_API_KEY=tvly-your_tavily_api_key_here

# ── Optional (local dev defaults are fine) ───────────────────────────

# Set to False in production, True for local dev
DEBUG=True

# Comma-separated list of allowed hosts
# e.g. ALLOWED_HOSTS=pitchsense.up.railway.app,localhost
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Production Only (set these on Railway/Render, not locally) ───────

# PostgreSQL connection string (provided by Railway/Render)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Redis for WebSocket channel layer AND cache backend (provided by Railway/Render)
# Used by: channel layer (pub/sub), rate limiter, auth check cache, Tavily cache
# REDIS_URL=redis://default:password@host:6379

# Sentry error tracking DSN (STRONGLY RECOMMENDED in production)
# Get a free DSN at: https://sentry.io
# Without this, production errors are only visible in Railway logs.
# SENTRY_DSN=https://your-dsn@sentry.io/project-id
